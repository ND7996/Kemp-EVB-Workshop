[MD]
steps                     200000
stepsize                        1.0
temperature                    300
bath_coupling                    100
separate_scaling                on
lrf                               on
shake_solvent                     on

[cut-offs]
solute_solute                 10
solvent_solvent               10
q_atom                        99

[sphere]
shell_force			  10
exclude_bonded		  on

[water]

[intervals]
non_bond                      30
output                     25000
energy                        10
trajectory                 25000

[files]
topology             SYSTEM_TOPOLOGY.top
restart              fep_006.re
final	         fep_004.re
energy	         fep_004.en
trajectory           fep_004.dcd
fep	                     SYSTEM_FEP.fep

[lambdas]
0.04   0.96
[sequence_restraints]
ASP_162_CB    ASP_162_OD2    0.5     0       0 
SUB_FIRST_ATOM    SUB_LAST_ATOM    0.5     0       0
